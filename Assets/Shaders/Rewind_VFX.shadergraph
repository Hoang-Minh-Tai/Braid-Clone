        {
            "m_Id": "37ec831c59404500a3877635c640d5e8"
        },
        {
            "m_Id": "873d488a3f604d9ea8e2d64eb7ece9b4"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "borderMask",
    "m_FunctionSource": "89c7b9b0665cee048aa9ef6600fa5bc9",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float maskX = smoothstep(0.0, width, st.x) - smoothstep(1-width, 1.0, step.x);\r\nfloat maskY = smoothstep(0.0, width, st.y) - smoothstep(1-width, 1.0, step.y);\r\nmask = maskX * maskY;"
}

